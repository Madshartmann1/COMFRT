# ============================================================================
# BAM FILE CLEANUP AND PROCESSING
# ============================================================================

rule bam_cleanup:
    """
    Process aligned BAM file: remove duplicates, sort, and index.
    For user-provided BAM files, this is the entry point.
    """
    input:
        bam = lambda wildcards: config.get('input_bam', '') if config['input_type'] == 'bam' 
              else f"{config['output_dir']}/alignment/{config['sample_name']}.sort.bam"
    output:
        rmdup = temp(f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.bam") if not config.get('keep_temp') else f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.bam",
        sorted = f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.sort.bam",
        bai = f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.sort.bam.bai",
        records = f"{config['output_dir']}/records/bam_cleanup_records.txt"
    threads:
        config['threads']
    log:
        f"{config['output_dir']}/logs/bam_cleanup.log"
    shell:
        """
        mkdir -p {config[output_dir]}/processed {config[output_dir]}/records
        
        # Remove duplicates
        {config[samtools]} rmdup -S {input.bam} {output.rmdup} 2> {log}
        
        # Sort
        {config[samtools]} sort -@ {threads} {output.rmdup} -o {output.sorted} 2>> {log}
        
        # Index
        {config[samtools]} index {output.sorted} 2>> {log}
        
        # Count reads
        cleaned_reads=$({config[samtools]} view -c {output.sorted})
        
        # Create records file
        echo "BAM Cleanup Records" > {output.records}
        echo "==================" >> {output.records}
        echo "Cleaned reads (duplicates removed): $cleaned_reads" >> {output.records}
        """


rule bam_statistics:
    """
    Calculate mapping statistics from BAM file.
    """
    input:
        bam = f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.sort.bam"
    output:
        stats = f"{config['output_dir']}/stats/{config['sample_name']}_mapping_stats.txt"
    threads:
        config['threads']
    log:
        f"{config['output_dir']}/logs/bam_stats.log"
    shell:
        """
        mkdir -p {config[output_dir]}/stats
        
        echo "Mapping Statistics" > {output.stats}
        echo "==================" >> {output.stats}
        echo "" >> {output.stats}
        
        echo "Total mapped reads:" >> {output.stats}
        {config[samtools]} view -c {input.bam} >> {output.stats}
        
        echo "" >> {output.stats}
        echo "Coverage and depth:" >> {output.stats}
        {config[samtools]} depth -a {input.bam} | \
            awk '{{sum+=$3;cnt++}}END{{print "Average depth: " sum/cnt "\\nTotal bases mapped: " sum}}' \
            >> {output.stats}
        
        echo "" >> {output.stats}
        echo "Mapping quality distribution:" >> {output.stats}
        {config[samtools]} view {input.bam} | cut -f5 | sort -n | uniq -c >> {output.stats}
        """


# ============================================================================
# MITOCHONDRIAL FILTERING RULES
# ============================================================================

rule filter_mitochondrial_mappings:
    """
    Filter BAM file to retain only reads that map at least once to mitochondrial scaffold(s).
    Uses awk for fast lookup of mitochondrial scaffold names in BAM file.
    """
    input:
        bam = f"{config['output_dir']}/processed/{config['sample_name']}.rmdup.sort.bam",
        cleanup_records = f"{config['output_dir']}/records/bam_cleanup_records.txt"
    output:
        filtered_bam = f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.bam",
        filtered_bai = f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.bam.bai",
        records = f"{config['output_dir']}/records/filter_MT_mappings_records.txt"
    params:
        mt_scaffolds = config['mt_scaffolds'],
        mt_pattern = lambda wildcards: '|'.join([f"{s}," for s in config['mt_scaffolds']])
    threads:
        config['threads']
    log:
        f"{config['output_dir']}/logs/filter_mt.log"
    shell:
        """
        mkdir -p {config[output_dir]}/filtered
        
        echo "Filtering for mitochondrial mappings..." > {log}
        echo "MT scaffolds: {params.mt_scaffolds}" >> {log}
        
        # Extract header
        {config[samtools]} view -H {input.bam} > {config[output_dir]}/filtered/temp_header.sam
        
        # Filter reads that map to MT scaffold (primary or secondary)
        # This checks both the reference column (field 3) and the XA tag for secondary alignments
        {config[samtools]} view {input.bam} | \
            awk -v mt="{params.mt_pattern}" \
            'BEGIN {{OFS="\\t"}} {{
                # Check if primary alignment is to MT (field 3 matches exactly)
                for (i=1; i<=split("{params.mt_scaffolds}", scaffolds, " "); i++) {{
                    if ($3 == scaffolds[i]) {{
                        print $0
                        next
                    }}
                }}
                # Check XA tag for secondary alignments to MT
                for (i=12; i<=NF; i++) {{
                    if ($i ~ /^XA:Z:/) {{
                        if ($i ~ mt) {{
                            print $0
                            break
                        }}
                    }}
                }}
            }}' >> {config[output_dir]}/filtered/temp_mt_reads.sam 2>> {log}
        
        # Combine header and filtered reads, convert to BAM
        cat {config[output_dir]}/filtered/temp_header.sam \
            {config[output_dir]}/filtered/temp_mt_reads.sam | \
            {config[samtools]} view -@ {threads} -b -o {output.filtered_bam} 2>> {log}
        
        # Index the filtered BAM
        {config[samtools]} index {output.filtered_bam} 2>> {log}
        
        # Clean up temp files
        rm {config[output_dir]}/filtered/temp_header.sam \
           {config[output_dir]}/filtered/temp_mt_reads.sam
        
        # Count filtered reads
        filtered_reads=$({config[samtools]} view -c {output.filtered_bam})
        
        # Calculate average depth on MT scaffold
        mt_scaffold="{params.mt_scaffolds}"
        avg_depth=$({config[samtools]} depth -a -g SECONDARY,SUPPLEMENTARY -r {params.mt_scaffolds} {output.filtered_bam} | awk '{{sum+=$3; count++}} END {{if(count>0) print sum/count; else print 0}}')
        
        # Create records file
        mkdir -p {config[output_dir]}/records
        echo \"Filter MT Mappings Records\" > {output.records}
        echo \"==========================\" >> {output.records}
        echo \"Reads that map at least once to the mitogenome: $filtered_reads\" >> {output.records}
        echo \"Average depth on the mitogenome: $avg_depth\" >> {output.records}

        # Report statistics to log
        echo "" >> {log}
        echo "Filtered BAM statistics:" >> {log}
        echo "Filtered reads: $filtered_reads" >> {log}
        echo "Average depth on MT scaffold: $avg_depth" >> {log}
        """


# ============================================================================
# NUMTS IDENTIFICATION RULES
