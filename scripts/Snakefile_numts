rule bam_to_text:
    """
    Convert filtered BAM to text format for Python processing.
    """
    input:
        bam = f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.bam"
    output:
        txt = temp(f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.txt") if not config.get('keep_temp') else f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.txt"
    threads:
        config['threads']
    log:
        f"{config['output_dir']}/logs/bam_to_text.log"
    shell:
        """
        {config[samtools]} view {input.bam} > {output.txt} 2> {log}
        """


rule identify_numts:
    """
    Run FragmentsMappingTwicePY.py to identify NUMTS sequences.
    Splits output into records file (first 4 lines) and numts list (remaining lines).
    """
    input:
        txt = f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.txt",
        filter_records = f"{config['output_dir']}/records/filter_MT_mappings_records.txt"
    output:
        numts = f"{config['output_dir']}/numts.txt",
        records = f"{config['output_dir']}/records/{config['mt_scaffolds'][0]}_records.txt"
    params:
        mt_scaffold = config['mt_scaffolds'][0],  # Use first MT scaffold as primary
        script_dir = config['script_dir']
    log:
        f"{config['output_dir']}/logs/identify_numts.log"
    shell:
        """
        mkdir -p {config[output_dir]}/records
        
        # Run the Python script and capture all output
        python3 {params.script_dir}/FragmentsMappingTwicePY.py \
            {input.txt} {params.mt_scaffold} > {config[output_dir]}/temp_numts_output.txt 2> {log}
        
        # Split output: first 4 lines go to records, rest to numts
        head -n 4 {config[output_dir]}/temp_numts_output.txt > {output.records}
        tail -n +5 {config[output_dir]}/temp_numts_output.txt > {output.numts}
        
        # Clean up temp file
        rm {config[output_dir]}/temp_numts_output.txt
        
        # Report statistics
        echo "NUMTS identification complete" >> {log}
        echo "Number of NUMTS found: $(wc -l < {output.numts})" >> {log}
        """


