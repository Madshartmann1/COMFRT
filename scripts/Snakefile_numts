rule index_reference:
    """
    Index reference genome for BWA and samtools faidx.
    """
    input:
        ref = config['reference']
    output:
        amb = f"{config['reference']}.amb",
        ann = f"{config['reference']}.ann",
        bwt = f"{config['reference']}.bwt",
        pac = f"{config['reference']}.pac",
        sa = f"{config['reference']}.sa",
        fai = f"{config['reference']}.fai"
    log:
        f"{config['output_dir']}/logs/bwa_index_reference.log"
    shell:
        """
        # Create samtools faidx index
        if [ ! -f {output.fai} ]; then
            echo "Creating samtools faidx index..." > {log}
            {config[samtools]} faidx {input.ref} 2>> {log}
        fi
        
        # Create BWA indices
        if [ ! -f {output.bwt} ]; then
            echo "Creating BWA indices..." >> {log}
            {config[bwa]} index {input.ref} 2>> {log}
        else
            echo "Reference already indexed" >> {log}
        fi
        """


# ============================================================================
# ALIGNMENT RULES
# ============================================================================

rule bwa_align_ds:
    """
    Align preprocessed paired-end reads to reference genome using BWA aln.
    IMPORTANT: Minimum alignment quality is set to 0 to retain multi-mapping reads.
    """
    input:
        fastq = f"{config['output_dir']}/preprocessed/{config['sample_name']}-merged.fastq",
        ref = config['reference'],
        index = f"{config['reference']}.bwt",
        preprocess_records = f"{config['output_dir']}/records/preprocessing_readsDS_records.txt"
    output:
        bam = temp(f"{config['output_dir']}/alignment/{config['sample_name']}.sort.bam") if not config.get('keep_temp') else f"{config['output_dir']}/alignment/{config['sample_name']}.sort.bam",
        records = f"{config['output_dir']}/records/align_readsDS_records.txt"
    threads:
        config['threads']
    params:
        seed_len = config['bwa_seed_length'],
        max_gap = config['bwa_max_gap_opens'],
        mismatch = config['bwa_mismatch_penalty']
    log:
        f"{config['output_dir']}/logs/bwa_align.log"
    shell:
        """
        mkdir -p {config[output_dir]}/alignment {config[output_dir]}/records
        
        # Align reads
        {config[bwa]} aln -l {params.seed_len} -o {params.max_gap} -n {params.mismatch} \
            -t {threads} {input.ref} {input.fastq} 2> {log} | \
        {config[bwa]} samse {input.ref} - {input.fastq} 2>> {log} | \
        {config[samtools]} view -F 4 -@ {threads} -uS - | \
        {config[samtools]} sort -@ {threads} -o {output.bam} 2>> {log}
        
        # Count aligned reads
        aligned_reads=$({config[samtools]} view -c {output.bam})
        
        # Create records file
        echo "Alignment Records (Paired-End)" > {output.records}
        echo "============================" >> {output.records}
        echo "Aligned reads: $aligned_reads" >> {output.records}
        """


rule bwa_align_ss:
