rule bam_to_fastq:
    """
    Convert filtered BAM to FASTQ format for remapping.
    Only runs if --remap option is specified.
    """
    input:
        bam = f"{config['output_dir']}/filtered/{config['sample_name']}_mt_filtered.bam"
    output:
        fastq = temp(f"{config['output_dir']}/remapping/{config['sample_name']}_mt_filtered.fq") if not config.get('keep_temp') else f"{config['output_dir']}/remapping/{config['sample_name']}_mt_filtered.fq"
    threads:
        config['threads']
    log:
        f"{config['output_dir']}/logs/bam_to_fastq.log"
    shell:
        """
        mkdir -p {config[output_dir]}/remapping
        
        # Convert BAM to FASTQ
        {config[samtools]} fastq {input.bam} > {output.fastq} 2> {log}
        """


rule recover_sequences:
    """
    Remove NUMTS sequences from FASTQ to create recovered sequences file.
    Only runs if --remap option is specified.
    """
    input:
        fastq = f"{config['output_dir']}/remapping/{config['sample_name']}_mt_filtered.fq",
        numts = f"{config['output_dir']}/numts.txt"
    output:
        recovered = temp(f"{config['output_dir']}/remapping/recovered_sequences.fq") if not config.get('keep_temp') else f"{config['output_dir']}/remapping/recovered_sequences.fq"
    log:
        f"{config['output_dir']}/logs/recover_sequences.log"
    shell:
        """
        # Use Python to accurately filter FASTQ based on exact read ID matching
        python3 - {input.fastq} {input.numts} {output.recovered} > {log} 2>&1 << 'PYTHON_EOF'
import sys
import re

fastq_file = sys.argv[1]
numts_file = sys.argv[2]
output_file = sys.argv[3]

# Read NUMTS IDs into a set for efficient lookup
numts_ids = set()
with open(numts_file, 'r') as f:
    for line in f:
        numts_ids.add(line.strip())

print(f"Loaded {{len(numts_ids)}} NUMTS IDs to exclude")

# Filter FASTQ file
recovered_count = 0
original_count = 0

with open(fastq_file, 'r') as infile, open(output_file, 'w') as outfile:
    while True:
        header = infile.readline()
        if not header:
            break
        
        seq = infile.readline()
        plus = infile.readline()
        qual = infile.readline()
        
        original_count += 1
        
        # Extract read ID (remove @ prefix)
        read_id = header.rstrip()[1:]
        
        # Keep read if it's NOT in the NUMTS list
        if read_id not in numts_ids:
            outfile.write(header)
            outfile.write(seq)
            outfile.write(plus)
            outfile.write(qual)
            recovered_count += 1

print(f"Recovered sequences extracted")
print(f"Original reads: {{original_count}}")
print(f"Recovered reads: {{recovered_count}}")
print(f"Removed {{original_count - recovered_count}} NUMTS")
PYTHON_EOF
        """


rule extract_mitochondrial_genome:
    """
    Extract mitochondrial genome sequence from reference for remapping.
    Only runs if --remap option is specified.
    """
    input:
        ref = config['reference'],
        ref_index = f"{config['reference']}.fai"
    output:
        mt_genome = temp(f"{config['output_dir']}/remapping/mt_genome.fasta") if not config.get('keep_temp') else f"{config['output_dir']}/remapping/mt_genome.fasta"
    params:
        mt_scaffolds = config['mt_scaffolds']
    log:
        f"{config['output_dir']}/logs/extract_mt_genome.log"
    shell:
        """
        # Extract mitochondrial scaffold(s) from reference
        # Reference must already be indexed (done by index_reference rule)
        for scaffold in {params.mt_scaffolds}; do
            {config[samtools]} faidx {input.ref} $scaffold >> {output.mt_genome} 2>> {log}
        done
        
        echo "Mitochondrial genome extracted" >> {log}
        """


rule index_mitochondrial_genome:
    """
    Index mitochondrial genome for BWA remapping.
    Only runs if --remap option is specified.
    """
    input:
        mt_genome = f"{config['output_dir']}/remapping/mt_genome.fasta"
    output:
        amb = f"{config['output_dir']}/remapping/mt_genome.fasta.amb",
        ann = f"{config['output_dir']}/remapping/mt_genome.fasta.ann",
        bwt = f"{config['output_dir']}/remapping/mt_genome.fasta.bwt",
        pac = f"{config['output_dir']}/remapping/mt_genome.fasta.pac",
        sa = f"{config['output_dir']}/remapping/mt_genome.fasta.sa",
        fai = f"{config['output_dir']}/remapping/mt_genome.fasta.fai"
    log:
        f"{config['output_dir']}/logs/index_mt_genome.log"
    shell:
        """
        # Remove any existing indices to force re-indexing
        rm -f {output.amb} {output.ann} {output.bwt} {output.pac} {output.sa} {output.fai}
        
        echo "Indexing mitochondrial genome..." > {log}
        
        # Index with samtools faidx for sequence extraction
        {config[samtools]} faidx {input.mt_genome} 2>> {log}
        
        # Index with BWA for alignment
        {config[bwa]} index {input.mt_genome} 2>> {log}
        
        echo "Mitochondrial genome indexed successfully" >> {log}
        """


rule remap_recovered_sequences:
    """
    Remap recovered sequences to mitochondrial genome only.
    Uses higher mapping quality threshold (default 20).
    Only runs if --remap option is specified.
    """
    input:
        fastq = f"{config['output_dir']}/remapping/recovered_sequences.fq",
        mt_genome = f"{config['output_dir']}/remapping/mt_genome.fasta",
        index = f"{config['output_dir']}/remapping/mt_genome.fasta.bwt"
    output:
        bam = f"{config['output_dir']}/{config['sample_name']}_recovered.bam",
        bai = f"{config['output_dir']}/{config['sample_name']}_recovered.bam.bai",
        records = f"{config['output_dir']}/records/remap_records.txt"
    threads:
        config['threads']
    params:
        seed_len = config['bwa_seed_length'],
        max_gap = config['bwa_max_gap_opens'],
        mismatch = config['bwa_mismatch_penalty'],
        min_qual = config['remap_quality'],
        mt_scaffold = config['mt_scaffolds'][0]
    log:
        f"{config['output_dir']}/logs/remap_recovered.log"
    shell:
        """
        echo "Remapping recovered sequences to mitochondrial genome..." > {log}
        
        # Map with BWA aln, filter for quality >= {params.min_qual}
        {config[bwa]} aln -l {params.seed_len} -o {params.max_gap} -n {params.mismatch} \
            -t {threads} {input.mt_genome} {input.fastq} 2>> {log} | \
        {config[bwa]} samse {input.mt_genome} - {input.fastq} 2>> {log} | \
        {config[samtools]} view -F 4 -q {params.min_qual} -@ {threads} -b - | \
        {config[samtools]} sort -@ {threads} -o {output.bam} 2>> {log}
        
        # Index the remapped BAM
        {config[samtools]} index {output.bam} 2>> {log}
        
        # Count remapped reads
        remapped_reads=$({config[samtools]} view -c {output.bam})
        
        # Calculate average depth on MT scaffold
        avg_depth=$({config[samtools]} depth -a {output.bam} | awk '{{sum+=$3; count++}} END {{if(count>0) print sum/count; else print 0}}')
        
        # Create records file
        mkdir -p {config[output_dir]}/records
        echo "Remap Records" > {output.records}
        echo "=============" >> {output.records}
        echo "Reads remapped with mapping quality above 20: $remapped_reads" >> {output.records}
        echo "Average depth of true mitochondrial reads (including recovered reads): $avg_depth" >> {output.records}
        
        # Report statistics to log
        echo "" >> {log}
        echo "Remapping statistics:" >> {log}
        echo "Reads remapped: $remapped_reads" >> {log}
        echo "Average depth: $avg_depth" >> {log}
        """


# ============================================================================
# COLLECT RECORDS RULE
# ============================================================================

rule collect_records:
    """
    Collect all individual record files into a final consolidated records file.
    Keeps individual record files for reference.
    """
    input:
        get_available_record_files
    output:
        final_records = f"{config['output_dir']}/records/records_final.txt"
    log:
        f"{config['output_dir']}/logs/collect_records.log"
    shell:
        """
        echo "Collecting all record files..." > {log}
        
        # Create final records file header
        echo "========================================" > {output.final_records}
        echo "NUMTS Pipeline - Final Records Summary" >> {output.final_records}
        echo "========================================" >> {output.final_records}
        echo "" >> {output.final_records}
        echo "Generated: $(date)" >> {output.final_records}
        echo "Sample: {config[sample_name]}" >> {output.final_records}
        echo "" >> {output.final_records}
        echo "========================================" >> {output.final_records}
        echo "" >> {output.final_records}
        
        # Concatenate all individual record files
        for record_file in {input}; do
            echo "" >> {output.final_records}
            echo "File: $(basename $record_file)" >> {output.final_records}
            echo "----------------------------------------" >> {output.final_records}
            cat $record_file >> {output.final_records}
            echo "" >> {output.final_records}
            echo "Collected: $record_file" >> {log}
        done
        
        echo "" >> {output.final_records}
        echo "========================================" >> {output.final_records}
        echo "End of Records Summary" >> {output.final_records}
        echo "========================================" >> {output.final_records}
        
        echo "All records collected successfully" >> {log}
        """


