"""
Snakemake pipeline for NUMTS (Nuclear Mitochondrial DNA segments) recovery
Author: Generated pipeline based on bash script template
"""

import os


# Load configuration
configfile: "config.yaml"


# Define output files based on input type and pipeline mode
def get_final_outputs(config):
    """Determine final output files based on configuration."""
    outputs = []
    
    # Always produce these outputs
    mt_tag = config['mt_scaffolds'][0]
    outputs.append(f"{config['output_dir']}/numts.txt")
    outputs.append(f"{config['output_dir']}/records/{mt_tag}_records.txt")
    
    # Final consolidated records file
    outputs.append(f"{config['output_dir']}/records/records_final.txt")
    
    # Optional remapping endpoint
    if config.get('remap', False):
        outputs.append(f"{config['output_dir']}/{config['sample_name']}_recovered.bam")
        outputs.append(f"{config['output_dir']}/{config['sample_name']}_recovered.bam.bai")
    
    return outputs


def get_available_record_files(wildcards):
    """Determine which record files should exist based on pipeline configuration."""
    records_dir = f"{config['output_dir']}/records"
    record_files = []
    
    # Preprocessing and alignment records (conditional on input type)
    if config['input_type'] == 'ds':
        record_files.append(f"{records_dir}/preprocessing_readsDS_records.txt")
        record_files.append(f"{records_dir}/align_readsDS_records.txt")
    elif config['input_type'] == 'ss':
        record_files.append(f"{records_dir}/preprocessing_readsSS_records.txt")
        record_files.append(f"{records_dir}/align_readsSS_records.txt")
    
    # Always present records
    record_files.append(f"{records_dir}/bam_cleanup_records.txt")
    record_files.append(f"{records_dir}/filter_MT_mappings_records.txt")
    record_files.append(f"{records_dir}/{config['mt_scaffolds'][0]}_records.txt")
    
    # Remapping records (conditional on --remap flag)
    if config.get('remap', False):
        record_files.append(f"{records_dir}/remap_records.txt")
    
    return record_files


# Define final rule
rule all:
    input:
        get_final_outputs(config)


# ============================================================================
# INPUT HANDLING RULES
# ============================================================================

rule check_ds_reads:
    """
    Rule for double-stranded (paired-end) reads.
    This rule is used when R1 and R2 files are detected.
    """
    input:
        r1 = config.get('input_r1', ''),
        r2 = config.get('input_r2', '')
    output:
        flag = temp(f"{config['output_dir']}/flags/ds_reads_checked.flag")
    run:
        if config['input_type'] == 'ds':
            shell("mkdir -p {config[output_dir]}/flags && touch {output.flag}")
        else:
            # This rule shouldn't run for non-ds input
            pass


rule check_ss_reads:
    """
    Rule for single-stranded (single-end) reads.
    This rule is used when only single FASTQ file is found.
    WARNING: User is warned about reduced sensitivity.
    """
    input:
        fastq = config.get('input_fastq', '')
    output:
        flag = temp(f"{config['output_dir']}/flags/ss_reads_checked.flag")
    run:
        if config['input_type'] == 'ss':
            print("WARNING: Using single-stranded read mode - may reduce NUMTS detection sensitivity")
            shell("mkdir -p {config[output_dir]}/flags && touch {output.flag}")
        else:
            # This rule shouldn't run for non-ss input
            pass


# ============================================================================
# PREPROCESSING RULES (for FASTQ inputs)
# ============================================================================

rule fastp_preprocess_ds:
    """
    Preprocess paired-end reads with fastp.
    Performs deduplication, quality filtering, and merging.
    """
    input:
        r1 = config.get('input_r1', ''),
        r2 = config.get('input_r2', ''),
        flag = f"{config['output_dir']}/flags/ds_reads_checked.flag"
    output:
        merged = temp(f"{config['output_dir']}/preprocessed/{config['sample_name']}-merged.fastq") if not config.get('keep_temp') else f"{config['output_dir']}/preprocessed/{config['sample_name']}-merged.fastq",
        json = f"{config['output_dir']}/preprocessed/{config['sample_name']}_fastp.json",
        html = f"{config['output_dir']}/preprocessed/{config['sample_name']}_fastp.html",
        records = f"{config['output_dir']}/records/preprocessing_readsDS_records.txt"
    threads:
        config['threads']
    params:
        min_quality = config['min_quality'],
        min_length = config['min_length']
    log:
        f"{config['output_dir']}/logs/fastp_preprocess.log"
    shell:
        """
        mkdir -p {config[output_dir]}/preprocessed {config[output_dir]}/logs {config[output_dir]}/records
        
        # Count input reads
        input_reads=$(( $(wc -l < {input.r1}) / 4 ))
        
        # Run fastp
        {config[fastp]} --dedup -g -j {output.json} -h {output.html} \
            -i {input.r1} -I {input.r2} \
            -V -w {threads} -q {params.min_quality} -l {params.min_length} \
            --merged_out {output.merged} -m \
            2> {log}
        
        # Count output reads
        output_reads=$(( $(wc -l < {output.merged}) / 4 ))
        
        # Create records file
        echo "Preprocessing Records (Paired-End)" > {output.records}
        echo "==================================" >> {output.records}
        echo "Input reads (R1): $input_reads" >> {output.records}
        echo "Merged output reads: $output_reads" >> {output.records}
        """

## here above we need the --dedup option to be in fastp, fastp just needs to be the right version first. above version 22 

rule fastp_preprocess_ss:
    """
    Preprocess single-end reads with fastp.
    Performs deduplication and quality filtering.
    """
    input:
        fastq = config.get('input_fastq', ''),
        flag = f"{config['output_dir']}/flags/ss_reads_checked.flag"
    output:
        filtered = temp(f"{config['output_dir']}/preprocessed/{config['sample_name']}-filtered.fastq") if not config.get('keep_temp') else f"{config['output_dir']}/preprocessed/{config['sample_name']}-filtered.fastq",
        json = f"{config['output_dir']}/preprocessed/{config['sample_name']}_fastp.json",
        html = f"{config['output_dir']}/preprocessed/{config['sample_name']}_fastp.html",
        records = f"{config['output_dir']}/records/preprocessing_readsSS_records.txt"
    threads:
        config['threads']
    params:
        min_quality = config['min_quality'],
        min_length = config['min_length']
    log:
        f"{config['output_dir']}/logs/fastp_preprocess.log"
    shell:
        """
        mkdir -p {config[output_dir]}/preprocessed {config[output_dir]}/logs {config[output_dir]}/records
        
        # Count input reads
        input_reads=$(( $(wc -l < {input.fastq}) / 4 ))
        
        # Run fastp
        {config[fastp]} --dedup -g -j {output.json} -h {output.html} \
            -i {input.fastq} -o {output.filtered} \
            -V -w {threads} -q {params.min_quality} -l {params.min_length} \
            2> {log}
        
        # Count output reads
        output_reads=$(( $(wc -l < {output.filtered}) / 4 ))
        
        # Create records file
        echo "Preprocessing Records (Single-End)" > {output.records}
        echo "==================================" >> {output.records}
        echo "Input reads: $input_reads" >> {output.records}
        echo "Filtered output reads: $output_reads" >> {output.records}
        """


# ============================================================================
# REFERENCE INDEXING RULES
